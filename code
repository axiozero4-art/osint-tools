def query_api(url, query):
    """Panggil API dan return data"""
    try:
        full_url = f"{url}{query}"
        r = requests.get(full_url, timeout=10)
        if r.status_code == 200:
            return r.json()
        return None
    except:
        return None

def tampilkan_data(jenis, data):
    """Tampilkan data sesuai format"""
    if not data or not data.get('status') or not data.get('data'):
        print(f"{R}❌ Data tidak ditemukan!{RESET}")
        return
    
    hasil = data['data']
    print(f"\n{G}✅ {len(hasil)} data ditemukan:{RESET}\n")
    
    for i, item in enumerate(hasil[:5], 1):  # Max 5 hasil
        print(f"{C}═══ DATA KE-{i} ═══{RESET}")
        for key, val in item.items():
            if val and str(val) != "null" and str(val) != "-" and str(val) != "-- Pilih -":
                print(f"  {Y}{key}{RESET}: {W}{val}{RESET}")
        print()

